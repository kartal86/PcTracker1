<Window x:Class="PcTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giriş Ekranı" Height="450" Width="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True">

    <Border CornerRadius="20" Background="#1E1E24" BorderBrush="#FFD700" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="10" Opacity="0.7"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="SİSTEME KİM GİRİŞ YAPIYOR?" 
                       Foreground="White" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,10,0,20" />

            <UniformGrid Grid.Row="1" Columns="2" Rows="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnHalil" Content="👑 Halil" Tag="Boss" Width="180" Height="60" Margin="10" FontSize="20" FontWeight="Bold" Background="#2B2D42" Foreground="White" Click="UserButton_Click"/>
                <Button x:Name="BtnIbrahim" Content="👑 İbrahim" Tag="Boss" Width="180" Height="60" Margin="10" FontSize="20" FontWeight="Bold" Background="#2B2D42" Foreground="White" Click="UserButton_Click"/>
                <Button x:Name="BtnAhmet" Content="🎮 Ahmet Emin" Tag="User" Width="180" Height="60" Margin="10" FontSize="18" Background="#2B2D42" Foreground="LightGray" Click="UserButton_Click"/>
                <Button x:Name="BtnIsmail" Content="🎮 İsmail" Tag="User" Width="180" Height="60" Margin="10" FontSize="18" Background="#2B2D42" Foreground="LightGray" Click="UserButton_Click"/>
            </UniformGrid>

            <StackPanel x:Name="PanelTime" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Hidden" Margin="0,20,0,10">
                <TextBlock Text="İzin Verilen Süre (Saat):" Foreground="White" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="ComboTime" Width="100" FontSize="18">
                    <ComboBoxItem Content="1" IsSelected="True"/>
                    <ComboBoxItem Content="1.5"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                </ComboBox>
            </StackPanel>

            <Button x:Name="BtnStart" Grid.Row="3" Content="SİSTEMİ BAŞLAT" Width="250" Height="50" FontSize="20" FontWeight="Bold" Background="#D90429" Foreground="White" Margin="0,10,0,10" Visibility="Hidden" Click="BtnStart_Click"/>
        </Grid>
    </Border>
</Window>
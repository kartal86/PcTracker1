<Window x:Class="PcTracker.BossModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Boss Mode" WindowState="Maximized" WindowStyle="None" 
        Topmost="True" Background="Black">
    <Grid>
        <!-- Video başlangıçta gizli ve manuel başlatılacak -->
        <MediaElement x:Name="BgVideo" Source="output.mp4" 
              Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Stop"
              MediaEnded="BgVideo_MediaEnded" Visibility="Hidden" Volume="1"/>

        <!-- Ekranda sadece bu yazı olacak -->
        <TextBlock x:Name="TxtWelcome" Foreground="#00FFFF" FontSize="70" FontWeight="Bold" 
                   FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect Color="#00FFFF" BlurRadius="25" ShadowDepth="0"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
<Window x:Class="PcTracker.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OverlayWindow"
        Width="350"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        IsHitTestVisible="False"
        ShowInTaskbar="False">

    <!-- Negatif margin kaldırıldı, her yönden eşit 10 birim boşluk bırakıldı -->
    <Border Background="#DD000000"
            CornerRadius="15"
            BorderBrush="#D90429"
            BorderThickness="2"
            Margin="10">

        <!-- Sabit Height değerleri kaldırıldı, içeriğe göre esneyecek -->
        <StackPanel VerticalAlignment="Center" Margin="15">

            <TextBlock Text="⚠️ SİSTEM UYARISI"
                       Foreground="#D90429"
                       FontWeight="Bold"
                       FontSize="16"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="TxtMessage"
                       Text="Mesaj buraya gelecek"
                       Foreground="White"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>